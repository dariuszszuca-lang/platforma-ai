{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/newsletter-send.js": { "maxDuration": 300 }
  },
  "crons": [
    {
      "path": "/api/newsletter-send",
      "schedule": "0 16 * * 1,4"
    },
    {
      "path": "/api/newsletter-send",
      "schedule": "0 17 * * 1,4"
    }
  ],
  "rewrites": [
    { "source": "/app", "destination": "/app.html" },
    { "source": "/produkt1-tracker", "destination": "/produkt1-tracker.html" },
    { "source": "/wdrozenie-ai", "destination": "/wdrozenie-ai.html" },
    { "source": "/playbooki", "destination": "/playbooki.html" }
  ]
}
