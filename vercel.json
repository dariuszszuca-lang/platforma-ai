{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/newsletter-send.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/newsletter-send",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/newsletter-send",
      "schedule": "0 17 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/produkt1-tracker",
      "destination": "/produkt1-tracker.html"
    },
    {
      "source": "/wdrozenie-ai",
      "destination": "/wdrozenie-ai.html"
    },
    {
      "source": "/playbooki",
      "destination": "/playbooki.html"
    }
  ],
  "redirects": [
    {
      "source": "/narzedzia",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/quiz",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/kalkulator",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/oferta",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/audyt",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/prompt-generator",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/roi-calculator",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/playbooki",
      "destination": "/produkty",
      "permanent": true
    },
    {
      "source": "/playbooki.html",
      "destination": "/produkty",
      "permanent": true
    },
    {
      "source": "/kokpit",
      "destination": "/produkty",
      "permanent": true
    },
    {
      "source": "/dziekujemy-kokpit",
      "destination": "/produkty",
      "permanent": true
    }
  ]
}
