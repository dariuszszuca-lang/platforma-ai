<!-- HERO -->
<section class="relative overflow-hidden">
  <div class="absolute inset-0 grain opacity-40 pointer-events-none"></div>
  <div class="max-w-6xl mx-auto px-5 pt-20 pb-16 md:pt-28 md:pb-24 relative">
    <div class="chip mb-6">
      <span class="dot pulse"></span>
      Start: poniedziałek 1 czerwca 2026, 11:00. Otwarta rejestracja.
    </div>
    <h1 class="display text-4xl md:text-6xl font-bold leading-[1.05] max-w-4xl">
      Buduj firmę AI-First <span class="text-amber2-600">w Claude Code</span>, krok po kroku.
    </h1>
    <p class="mt-6 text-lg md:text-xl text-ink-700 max-w-2xl leading-relaxed">
      Cykliczne sesje na żywo dla tych, którzy już pracują w terminalu. Claude Code, Codex, MCP, API, automatyzacje. Razem budujemy systemy, które zostają w Twojej firmie.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="#cena" class="btn-accent">
        Dołącz za 2 000 zł / rok
        <i data-lucide="arrow-right" class="w-4 h-4"></i>
      </a>
      <a href="#co-zbudujesz" class="btn-ghost">
        Co zbudujesz
        <i data-lucide="chevron-down" class="w-4 h-4"></i>
      </a>
    </div>
    <div class="mt-10 flex flex-wrap items-center gap-3">
      <span class="chip"><i data-lucide="terminal" class="w-4 h-4 text-amber2-600"></i> Claude Code + Opus 4.7</span>
      <span class="chip"><i data-lucide="calendar" class="w-4 h-4 text-amber2-600"></i> Min. 3 sesje / mies.</span>
      <span class="chip"><i data-lucide="video" class="w-4 h-4 text-amber2-600"></i> Wszystko nagrywane</span>
      <span class="chip"><i data-lucide="users" class="w-4 h-4 text-amber2-600"></i> Zamknięta grupa</span>
    </div>
  </div>
</section>

<!-- PROBLEM / ROZWIĄZANIE -->
<section class="py-16 md:py-24 border-t border-cream-200">
  <div class="max-w-6xl mx-auto px-5">
    <div class="accent-bar mb-5"></div>
    <h2 class="display text-3xl md:text-4xl font-bold max-w-3xl">
      Masz asystentów. Nie masz systemu.
    </h2>
    <p class="mt-4 text-ink-700 max-w-2xl">
      Claude Code, Codex, własne agenty, MCP, API. Pojedyncze rzeczy działają. Ale firma dalej wymaga Ciebie do wszystkiego.
    </p>

    <div class="grid md:grid-cols-2 gap-5 mt-12">
      <div class="card p-7">
        <div class="text-xs font-bold tracking-widest text-ink-500 mb-2">TERAZ</div>
        <h3 class="display text-xl font-bold mb-4">Asystent czeka na polecenie</h3>
        <ul class="space-y-3 text-ink-700">
          <li class="flex gap-3"><i data-lucide="x" class="w-5 h-5 text-ink-500 shrink-0 mt-0.5"></i><span>Ty koordynujesz przepływ pracy</span></li>
          <li class="flex gap-3"><i data-lucide="x" class="w-5 h-5 text-ink-500 shrink-0 mt-0.5"></i><span>Masz dziesiątki promptów, ale bez spójnej architektury</span></li>
          <li class="flex gap-3"><i data-lucide="x" class="w-5 h-5 text-ink-500 shrink-0 mt-0.5"></i><span>Firma staje, kiedy śpisz</span></li>
          <li class="flex gap-3"><i data-lucide="x" class="w-5 h-5 text-ink-500 shrink-0 mt-0.5"></i><span>Automatyzacje rozsypane po Zapier, Make, n8n, lokalne skrypty</span></li>
        </ul>
      </div>
      <div class="card p-7" style="border-color:#b45309;">
        <div class="text-xs font-bold tracking-widest text-amber2-600 mb-2">PO AI-TEAM STUDIO</div>
        <h3 class="display text-xl font-bold mb-4">System działa sam</h3>
        <ul class="space-y-3 text-ink-700">
          <li class="flex gap-3"><i data-lucide="check" class="w-5 h-5 text-amber2-600 shrink-0 mt-0.5"></i><span>Agenci pracują w tle, raportują do Ciebie</span></li>
          <li class="flex gap-3"><i data-lucide="check" class="w-5 h-5 text-amber2-600 shrink-0 mt-0.5"></i><span>Cała architektura w jednym repo, pod kontrolą</span></li>
          <li class="flex gap-3"><i data-lucide="check" class="w-5 h-5 text-amber2-600 shrink-0 mt-0.5"></i><span>Firma sprzedaje i obsługuje. Ty decydujesz strategicznie</span></li>
          <li class="flex gap-3"><i data-lucide="check" class="w-5 h-5 text-amber2-600 shrink-0 mt-0.5"></i><span>Mniej narzędzi, więcej spójności</span></li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- CO ZBUDUJESZ -->
<section id="co-zbudujesz" class="py-16 md:py-24 border-t border-cream-200 bg-white">
  <div class="max-w-6xl mx-auto px-5">
    <div class="accent-bar mb-5"></div>
    <h2 class="display text-3xl md:text-4xl font-bold">Co zbudujesz razem ze mną</h2>
    <p class="mt-4 text-ink-700 max-w-2xl">Każda sesja to jeden system. Każdy system to jeden element autonomicznej firmy. Dołączasz kiedy chcesz, budujesz we własnym tempie.</p>

    <div class="grid md:grid-cols-2 gap-5 mt-12">
      <div class="soft-card p-7">
        <div class="display text-xs font-bold tracking-widest text-amber2-600 mb-2">OPERATIONS</div>
        <h3 class="display text-xl font-bold mb-2">AI Email Command Center</h3>
        <p class="text-ink-700">Claude Code czyta pocztę, klasyfikuje, odpowiada na proste sprawy, eskaluje ważne. Integracja Gmail + MCP + Twoje kontekstowe pliki.</p>
      </div>

      <div class="soft-card p-7">
        <div class="display text-xs font-bold tracking-widest text-amber2-600 mb-2">SALES</div>
        <h3 class="display text-xl font-bold mb-2">Sales Autopilot</h3>
        <p class="text-ink-700">Agent obsługuje lejek: lead przychodzi → AI kwalifikuje → pisze follow-up → wrzuca do CRM. Ty tylko dzwonisz do tych, co wygrywają.</p>
      </div>

      <div class="soft-card p-7">
        <div class="display text-xs font-bold tracking-widest text-amber2-600 mb-2">FINANCE</div>
        <h3 class="display text-xl font-bold mb-2">Finance & Cost Monitor</h3>
        <p class="text-ink-700">Dashboard finansowy z AI, który codziennie liczy marżę, wykrywa anomalie, alarmuje przy nietypowych wydatkach. Stripe, banki, faktury w jednym miejscu.</p>
      </div>

      <div class="soft-card p-7">
        <div class="display text-xs font-bold tracking-widest text-amber2-600 mb-2">CONTENT</div>
        <h3 class="display text-xl font-bold mb-2">Content Pipeline</h3>
        <p class="text-ink-700">Jeden temat → newsletter + post LinkedIn + rolka + artykuł SEO. Wszystko generowane z kontekstu Twojej firmy, zapisywane w repo, publikowane automatycznie.</p>
      </div>

      <div class="soft-card p-7">
        <div class="display text-xs font-bold tracking-widest text-amber2-600 mb-2">KNOWLEDGE</div>
        <h3 class="display text-xl font-bold mb-2">Notification Intelligence Hub</h3>
        <p class="text-ink-700">Koniec z 40 zakładkami i 12 aplikacjami. AI agreguje powiadomienia, streszcza, pokazuje tylko to, co wymaga Twojej uwagi.</p>
      </div>

      <div class="soft-card p-7">
        <div class="display text-xs font-bold tracking-widest text-amber2-600 mb-2">INFRA</div>
        <h3 class="display text-xl font-bold mb-2">Cloud CTO</h3>
        <p class="text-ink-700">AWS, Vercel, Firebase pod jednym agentem. Deployy, monitoring, koszty, bezpieczeństwo. Mały zespół nie potrzebuje DevOps, jeśli ma dobrego agenta.</p>
      </div>
    </div>

    <div class="card p-7 mt-5 flex flex-col md:flex-row md:items-center md:justify-between gap-5">
      <div>
        <div class="display text-xs font-bold tracking-widest text-amber2-600 mb-1">PLUS</div>
        <h3 class="display text-xl font-bold">Biblioteka promptów, skryptów, szablonów</h3>
        <p class="text-ink-700 mt-1">Wszystko co budujemy na sesjach trafia do wspólnego repo. Pobierasz, wklejasz do swojej firmy, adaptujesz. Żadnego startu od zera.</p>
      </div>
      <a href="#cena" class="btn-ghost shrink-0">Zobacz cenę <i data-lucide="arrow-right" class="w-4 h-4"></i></a>
    </div>
  </div>
</section>

<!-- SESJE -->
<section id="sesje" class="py-16 md:py-24 border-t border-cream-200">
  <div class="max-w-6xl mx-auto px-5">
    <div class="accent-bar mb-5"></div>
    <h2 class="display text-3xl md:text-4xl font-bold">Jak to działa</h2>

    <div class="grid md:grid-cols-3 gap-5 mt-12">
      <div class="card p-7">
        <div class="w-10 h-10 rounded-lg bg-cream-100 flex items-center justify-center mb-4">
          <i data-lucide="video" class="w-5 h-5 text-amber2-600"></i>
        </div>
        <h3 class="display text-lg font-bold mb-2">Sesje live</h3>
        <p class="text-ink-700 text-sm">Poniedziałki 11:00-13:00, min. 3 razy w miesiącu (czasem 4). Teoria (15-20 min), wdrożenie na żywo w Claude Code (60-80 min), Q&A (20-30 min).</p>
      </div>
      <div class="card p-7">
        <div class="w-10 h-10 rounded-lg bg-cream-100 flex items-center justify-center mb-4">
          <i data-lucide="archive" class="w-5 h-5 text-amber2-600"></i>
        </div>
        <h3 class="display text-lg font-bold mb-2">Wszystko nagrywane</h3>
        <p class="text-ink-700 text-sm">Nie musisz być live. Nagrania, transkrypcje i kod z sesji lądują w portalu tego samego dnia. Wracasz kiedy chcesz, przegrywasz na prędkości 1.5x.</p>
      </div>
      <div class="card p-7">
        <div class="w-10 h-10 rounded-lg bg-cream-100 flex items-center justify-center mb-4">
          <i data-lucide="message-circle" class="w-5 h-5 text-amber2-600"></i>
        </div>
        <h3 class="display text-lg font-bold mb-2">Zamknięta grupa</h3>
        <p class="text-ink-700 text-sm">Pytasz między sesjami, dzielisz się postępami, widzisz jak budują inni. Małe środowisko praktyków, nie masowy kurs.</p>
      </div>
    </div>

    <div class="card p-7 mt-10">
      <h3 class="display text-xl font-bold mb-5">Najbliższe sesje</h3>
      <div class="space-y-3 text-sm">
        <div class="flex items-center justify-between border-b border-cream-200 pb-3">
          <div>
            <div class="font-semibold">Sesja #1. Cloud CTO (setup bazowy)</div>
            <div class="text-ink-500">Stawiamy repo, MCP, pierwszy agent, zasady pracy.</div>
          </div>
          <div class="text-right text-ink-700 shrink-0 ml-4">pon. 01.06.2026<br><span class="text-ink-500">11:00</span></div>
        </div>
        <div class="flex items-center justify-between border-b border-cream-200 pb-3">
          <div>
            <div class="font-semibold">Sesja #2. AI Email Command Center</div>
            <div class="text-ink-500">Gmail + Claude + zasady, jak pisać za Ciebie.</div>
          </div>
          <div class="text-right text-ink-700 shrink-0 ml-4">pon. 08.06.2026<br><span class="text-ink-500">11:00</span></div>
        </div>
        <div class="flex items-center justify-between border-b border-cream-200 pb-3">
          <div>
            <div class="font-semibold">Sesja #3. Cost & Security Manager</div>
            <div class="text-ink-500">Budżety AI, klucze API, audyt bezpieczeństwa, alerty.</div>
          </div>
          <div class="text-right text-ink-700 shrink-0 ml-4">pon. 15.06.2026<br><span class="text-ink-500">11:00</span></div>
        </div>
        <div class="flex items-center justify-between border-b border-cream-200 pb-3">
          <div>
            <div class="font-semibold">Sesja #4. Sales Autopilot</div>
            <div class="text-ink-500">Lead → AI kwalifikacja → follow-up → CRM. End-to-end.</div>
          </div>
          <div class="text-right text-ink-700 shrink-0 ml-4">pon. 22.06.2026<br><span class="text-ink-500">11:00</span></div>
        </div>
        <div class="flex items-center justify-between">
          <div>
            <div class="font-semibold">Sesja #5. Notification Intelligence Hub</div>
            <div class="text-ink-500">Agregacja i streszczanie powiadomień z 10 aplikacji.</div>
          </div>
          <div class="text-right text-ink-700 shrink-0 ml-4">pon. 29.06.2026<br><span class="text-ink-500">11:00</span></div>
        </div>
      </div>
      <p class="text-xs text-ink-500 mt-5">Terminy mogą się zmieniać. Wszystkie sesje nagrywane.</p>
    </div>
  </div>
</section>

<!-- DLA KOGO -->
<section id="dla-kogo" class="py-16 md:py-24 border-t border-cream-200 bg-white">
  <div class="max-w-6xl mx-auto px-5">
    <div class="accent-bar mb-5"></div>
    <h2 class="display text-3xl md:text-4xl font-bold">AI-TEAM Studio nie jest dla wszystkich</h2>

    <div class="grid md:grid-cols-2 gap-5 mt-12">
      <div class="soft-card p-7">
        <div class="display text-xs font-bold tracking-widest text-amber2-600 mb-3">DLA CIEBIE JEŚLI</div>
        <ul class="space-y-3 text-ink-700">
          <li class="flex gap-3"><i data-lucide="check" class="w-5 h-5 text-amber2-600 shrink-0 mt-0.5"></i><span>Używasz <b>Claude Code</b> lub <b>OpenAI Codex</b> w terminalu</span></li>
          <li class="flex gap-3"><i data-lucide="check" class="w-5 h-5 text-amber2-600 shrink-0 mt-0.5"></i><span>Masz działających asystentów AI (min. 1-2 w codziennym użyciu)</span></li>
          <li class="flex gap-3"><i data-lucide="check" class="w-5 h-5 text-amber2-600 shrink-0 mt-0.5"></i><span>Prowadzisz firmę lub projekt, na którym możesz budować</span></li>
          <li class="flex gap-3"><i data-lucide="check" class="w-5 h-5 text-amber2-600 shrink-0 mt-0.5"></i><span>Masz 2-4h tygodniowo na wdrażanie systemów</span></li>
          <li class="flex gap-3"><i data-lucide="check" class="w-5 h-5 text-amber2-600 shrink-0 mt-0.5"></i><span>Chcesz budować, nie tylko oglądać</span></li>
        </ul>
      </div>
      <div class="card p-7">
        <div class="display text-xs font-bold tracking-widest text-ink-500 mb-3">NIE DLA CIEBIE JEŚLI</div>
        <ul class="space-y-3 text-ink-700">
          <li class="flex gap-3"><i data-lucide="x" class="w-5 h-5 text-ink-500 shrink-0 mt-0.5"></i><span>Nie znasz Claude Code ani Codex</span></li>
          <li class="flex gap-3"><i data-lucide="x" class="w-5 h-5 text-ink-500 shrink-0 mt-0.5"></i><span>Nie masz jeszcze żadnego asystenta AI w codziennym użyciu</span></li>
          <li class="flex gap-3"><i data-lucide="x" class="w-5 h-5 text-ink-500 shrink-0 mt-0.5"></i><span>Szukasz kursu "AI dla początkujących"</span></li>
          <li class="flex gap-3"><i data-lucide="x" class="w-5 h-5 text-ink-500 shrink-0 mt-0.5"></i><span>Chcesz tylko teorii bez wdrażania</span></li>
        </ul>
        <p class="text-sm text-ink-500 mt-4">Jesteś początkujący? Zacznij od <a href="/warsztaty-ai.html" class="underline hover:text-ink-900">warsztatów AI-TEAM</a> w Sopocie.</p>
      </div>
    </div>
  </div>
</section>

<!-- PROWADZĄCY -->
<section id="prowadzacy" class="py-16 md:py-24 border-t border-cream-200">
  <div class="max-w-6xl mx-auto px-5">
    <div class="accent-bar mb-5"></div>
    <h2 class="display text-3xl md:text-4xl font-bold">Kto prowadzi</h2>

    <div class="card p-7 mt-10 grid md:grid-cols-3 gap-7">
      <div>
        <div class="aspect-square rounded-xl bg-cream-100 flex items-center justify-center text-5xl display font-bold text-amber2-600">DS</div>
      </div>
      <div class="md:col-span-2">
        <h3 class="display text-2xl font-bold">Dariusz Szuca</h3>
        <p class="text-ink-500 mt-1">Twórca AI-TEAM. Buduje systemy AI dla małych firm i dla siebie.</p>
