    <style>
      body { background: #f6f1e6; color: #1c1917; font-family: 'Inter', sans-serif; }
      .display { font-family: 'Space Grotesk', sans-serif; letter-spacing: -0.02em; }
      .card { background: #ffffff; border: 1px solid #eaddc6; border-radius: 16px; }
      .soft-card { background: #fbf7ed; border: 1px solid #eaddc6; border-radius: 16px; }
      .accent-bar { height: 4px; width: 48px; background: #b45309; border-radius: 2px; }
      .btn-primary {
        background: #1c1917; color: #fff; padding: 14px 26px; border-radius: 999px;
        font-weight: 600; display: inline-flex; align-items: center; gap: 8px;
        transition: transform .15s ease, background .15s ease;
      }
      .btn-primary:hover { background: #000; transform: translateY(-1px); }
      .btn-accent {
        background: #b45309; color: #fff; padding: 14px 26px; border-radius: 999px;
        font-weight: 600; display: inline-flex; align-items: center; gap: 8px;
        transition: transform .15s ease, background .15s ease;
      }
      .btn-accent:hover { background: #92400e; transform: translateY(-1px); }
      .btn-ghost {
        background: transparent; color: #1c1917; padding: 14px 26px; border-radius: 999px;
        font-weight: 600; border: 1.5px solid #1c1917; display: inline-flex; align-items: center; gap: 8px;
      }
      .chip {
        display: inline-flex; align-items: center; gap: 6px;
        background: #fff; border: 1px solid #eaddc6; border-radius: 999px;
        padding: 6px 14px; font-size: 13px; color: #44403c; font-weight: 500;
      }
      .dot { width: 8px; height: 8px; border-radius: 50%; background: #b45309; }
      .pulse { animation: pulse 2s ease-in-out infinite; }
      @keyframes pulse { 0%,100% { opacity: 1 } 50% { opacity: .5 } }
      .grain { background-image: radial-gradient(circle at 1px 1px, #e8dfc9 1px, transparent 0); background-size: 22px 22px; }
      .price-row { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px dashed #eaddc6; }
      .price-row:last-child { border-bottom: 0; }
      .price-row.active { background: #fef3c7; margin: 0 -14px; padding: 10px 14px; border-radius: 8px; border-bottom: 0; }
    </style>
</head>
