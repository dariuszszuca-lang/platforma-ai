                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        display: ['Space Grotesk', 'sans-serif'],
                    },
                    colors: {
                        cream: { 50: '#faf7f0', 100: '#f5f0e4', 200: '#e8dfc9' },
                        ink: { 900: '#1c1917', 700: '#44403c', 500: '#78716c', 300: '#a8a29e' },
                        amber2: { 500: '#d97706', 600: '#b45309', 700: '#92400e' }
                    }
                }
            }
        }
