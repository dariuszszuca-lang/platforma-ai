// ===== ASYNC DESK =====
function listenToAsyncCases() {
    const loading = document.getElementById('asyncLoading');
    const errorEl = document.getElementById('asyncError');

    try {
        loading.classList.remove('hidden');
        errorEl.classList.add('hidden');

        db.collection('zlecenia')
            .onSnapshot(
                (snapshot) => {
                    allAsyncCases = [];
                    snapshot.forEach(doc => {
                        const data = { id: doc.id, ...doc.data() };
                        if (data.case_type === 'async' || data.source === 'async-platform') {
                            allAsyncCases.push(data);
                        }
                    });
                    allAsyncCases.sort((a, b) => dateValue(b.created_at || b.createdAt) - dateValue(a.created_at || a.createdAt));
                    loading.classList.add('hidden');
                    errorEl.classList.add('hidden');
                    updateAsyncStats();
                    renderAsyncCases();
                },
                (error) => {
                    console.error('Async Firestore error:', error);
