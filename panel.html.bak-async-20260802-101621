async function saveAsyncCase(id) {
    try {
        const user = auth.currentUser;
        if (!user) throw new Error('Brak aktywnej sesji.');

        const current = allAsyncCases.find(item => item.id === id) || {};
        const status = document.getElementById(`asyncStatus-${id}`).value;
        const responseText = document.getElementById(`asyncResponse-${id}`).value.trim();
        const responseUrl = document.getElementById(`asyncResponseUrl-${id}`).value.trim();
        const notes = document.getElementById(`asyncNotes-${id}`).value.trim();
        const now = new Date().toISOString();

        const update = {
            status,
            response_text: responseText,
            response_url: responseUrl,
            internal_notes: notes,
            updated_at: now
        };

        if (status === 'answered' && !current.answered_at) update.answered_at = now;

        await db.collection('zlecenia').doc(id).update(update);
        showToast('Zapisano sprawę async', 'success');
    } catch (error) {
        console.error('Async save error:', error);
        showToast(error.message || 'Błąd zapisu sprawy async', 'error');
    }
}

