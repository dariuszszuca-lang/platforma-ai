function showDashboard() {
    document.getElementById('authModal').classList.add('hidden');
    document.getElementById('dashboard').classList.remove('hidden');

    if (dashboardInitialized) return;
    dashboardInitialized = true;

    setTimeout(function() {
        try {
            initDashboard();
        } catch (error) {
            console.error('Dashboard init error:', error);
            showToast('Zalogowano, ale panel nie załadował danych. Odśwież stronę.', 'error');
        }
    }, 0);
}

function showAuthError(error) {
    const card = document.getElementById('authCard');
    const err = document.getElementById('authError');

    console.error('Auth error:', error);
    err.classList.remove('hidden');

    if (error.code === 'auth/user-not-found' || error.code === 'auth/wrong-password' || error.code === 'auth/invalid-credential') {
        err.textContent = 'Błędny email lub hasło';
    } else if (error.code === 'auth/too-many-requests') {
        err.textContent = 'Za dużo prób — spróbuj za chwilę';
    } else if (error.code === 'auth/invalid-api-key') {
        err.textContent = 'Błąd konfiguracji logowania';
    } else {
        err.textContent = 'Błąd logowania: ' + (error.code || 'sprawdź konsolę');
    }

    card.classList.add('shake');
    setTimeout(function() { card.classList.remove('shake'); }, 500);
}

function checkAuth() {
    const email = document.getElementById('authEmail').value.trim();
    const password = document.getElementById('authPassword').value;
    const btn = document.getElementById('authBtn');
    const err = document.getElementById('authError');

    if (!email || !password) {
        err.classList.remove('hidden');
        err.textContent = 'Wpisz email i hasło';
        return;
    }

    btn.textContent = 'Logowanie...';
    btn.disabled = true;

    auth.signInWithEmailAndPassword(email, password)
        .then(showDashboard)
        .catch(function(error) {
            showAuthError(error);
            btn.textContent = 'Zaloguj';
            btn.disabled = false;
        });
}

function logout() {
    auth.signOut().then(function() { location.reload(); });
