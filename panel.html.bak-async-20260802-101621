function listenToNewsletterIssues() {
    db.collection('newsletter_issues')
        .orderBy('scheduled_at', 'desc')
        .onSnapshot(
            (snapshot) => {
                const remoteIssues = [];
                snapshot.forEach(doc => remoteIssues.push({ id: doc.id, ...doc.data() }));
                allNewsletterIssues = mergeNewsletterIssues(remoteIssues, fallbackNewsletterIssues);
                renderNewsletterIssues();
            },
            (error) => {
                console.warn('Newsletter issues fallback:', error);
                allNewsletterIssues = fallbackNewsletterIssues;
                renderNewsletterIssues();
            }
        );
}

function mergeNewsletterIssues(remoteIssues, localIssues) {
    const byId = new Map();
    localIssues.forEach(issue => byId.set(issue.id, issue));
    remoteIssues.forEach(issue => {
        byId.set(issue.id, {
            ...(byId.get(issue.id) || {}),
            ...issue,
            source: issue.source || 'firestore'
        });
    });
    return Array.from(byId.values()).sort((a, b) => {
        const aTime = Date.parse(a.scheduled_at || '') || 0;
        const bTime = Date.parse(b.scheduled_at || '') || 0;
        return bTime - aTime;
    });
}

