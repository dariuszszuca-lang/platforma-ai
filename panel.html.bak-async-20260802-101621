    return map[status] || map.draft;
}

function openIssuePreview(url, title) {
    if (!url) {
        showToast('Brak adresu podglądu HTML', 'error');
        return;
    }

    document.getElementById('issuePreviewTitle').textContent = title || 'AI Radar';
    document.getElementById('issuePreviewOpen').href = url;
    document.getElementById('issuePreviewFrame').src = url;
    document.getElementById('issuePreviewModal').classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    lucide.createIcons();
}

function closeIssuePreview() {
    document.getElementById('issuePreviewFrame').src = 'about:blank';
    document.getElementById('issuePreviewModal').classList.add('hidden');
    document.body.style.overflow = '';
}

async function sendNewsletterIssue(issueId, mode) {
    try {
        const user = auth.currentUser;
        if (!user) throw new Error('Zaloguj się ponownie do panelu.');

        const payload = { issueId };
        if (mode === 'dry') {
            payload.dryRun = true;
        } else if (mode === 'test') {
            const defaultEmail = user.email || 'darek@ai-team.pl';
            const testTo = window.prompt('Na jaki adres wysłać test?', defaultEmail);
            if (!testTo) return;
            payload.dryRun = false;
            payload.testTo = testTo.trim();
            payload.limit = 1;
        } else if (mode === 'send') {
            const confirmed = window.confirm('To wyśle wydanie do aktywnych kontaktów z tej grupy. Kontynuować?');
            if (!confirmed) return;
            payload.mode = 'send';
            payload.dryRun = false;
        }

        showToast(mode === 'dry' ? 'Sprawdzam wydanie...' : 'Uruchamiam wysyłkę...', 'info');

        const token = await user.getIdToken();
        const response = await fetch('/api/newsletter-send', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                Authorization: 'Bearer ' + token
            },
            body: JSON.stringify(payload)
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok || !data.ok) {
            throw new Error(data.error || 'Nie udało się uruchomić wysyłki.');
        }

        const summary = mode === 'dry'
            ? `Gotowe: ${data.planned || 0} adresów do wysyłki.`
            : `Wysłano: ${data.sent || 0}, błędy: ${data.failed || 0}.`;
        showToast(summary, data.failed ? 'error' : 'success');
    } catch (error) {
        console.error('Newsletter send error:', error);
        showToast(error.message || 'Błąd wysyłki newslettera', 'error');
    }
}

function renderSubscriberCard(subscriber) {
    const status = subscriber.status || 'active';
    const statusBadge = getSubscriberStatusBadge(status);
    const group = subscriber.group || 'ai-radar';
    const date = formatDate(subscriber.created_at);
    const name = subscriber.name || 'Bez imienia';
    const source = subscriber.source || 'ai-radar';

    return `
    <div class="rounded-xl border border-white/10 bg-white/[0.035] p-4">
        <div class="flex flex-col lg:flex-row lg:items-center gap-4">
            <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2 mb-2">
                    <span class="${statusBadge.classes} text-xs font-medium px-2.5 py-1 rounded-full border">${statusBadge.label}</span>
                    <span class="text-xs text-brand-light bg-brand-primary/10 border border-brand-primary/20 px-2.5 py-1 rounded-full">${getNewsletterGroupLabel(group)}</span>
                    <span class="text-xs text-gray-500">${date}</span>
                </div>
                <div class="font-semibold text-white truncate">${escHtml(subscriber.email || '')}</div>
                <div class="text-sm text-gray-400 mt-1">${escHtml(name)} · źródło: ${escHtml(source)}</div>
            </div>
            <div class="grid sm:grid-cols-2 gap-2 lg:w-[360px]">
                <select onchange="updateNewsletterContact('${subscriber.id}', { group: this.value })"
                    class="bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-brand-primary/50">
                    ${renderNewsletterGroupOptions(group)}
                </select>
                <select onchange="updateNewsletterContact('${subscriber.id}', { status: this.value })"
                    class="bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-brand-primary/50">
                    <option value="active" ${status === 'active' ? 'selected' : ''}>Aktywny</option>
                    <option value="unsubscribed" ${status === 'unsubscribed' ? 'selected' : ''}>Wypisany</option>
                    <option value="do_not_contact" ${status === 'do_not_contact' ? 'selected' : ''}>Nie pisać</option>
                    <option value="archived" ${status === 'archived' ? 'selected' : ''}>Archiwum</option>
                </select>
            </div>
        </div>
    </div>`;
}

function renderNewsletterGroupOptions(activeGroup) {
    const groups = {
        'ai-radar': 'AI Radar',
        crm: 'CRM i sprzedaż',
        automatyzacje: 'Automatyzacje',
        narzedzia: 'Narzędzia AI',
        warsztaty: 'Warsztaty'
    };

    return Object.keys(groups).map(key =>
        `<option value="${key}" ${activeGroup === key ? 'selected' : ''}>${groups[key]}</option>`
    ).join('');
}

function getNewsletterGroupLabel(group) {
    const labels = {
        'ai-radar': 'AI Radar',
        crm: 'CRM i sprzedaż',
        automatyzacje: 'Automatyzacje',
        narzedzia: 'Narzędzia AI',
        warsztaty: 'Warsztaty'
    };
    return labels[group] || 'AI Radar';
}

function getSubscriberStatusBadge(status) {
    const map = {
        active: { label: 'Aktywny', classes: 'bg-green-500/20 text-green-400 border-green-500/30' },
        unsubscribed: { label: 'Wypisany', classes: 'bg-gray-500/20 text-gray-300 border-gray-500/30' },
        do_not_contact: { label: 'Nie pisać', classes: 'bg-red-500/20 text-red-400 border-red-500/30' },
        bounced: { label: 'Odbicie', classes: 'bg-yellow-500/20 text-yellow-400 border-yellow-500/30' },
        complained: { label: 'Skarga', classes: 'bg-red-500/20 text-red-400 border-red-500/30' },
        archived: { label: 'Archiwum', classes: 'bg-gray-500/20 text-gray-400 border-gray-500/30' }
    };
    return map[status] || map.active;
}

async function updateNewsletterContact(id, changes) {
    try {
        const user = auth.currentUser;
        if (!user) throw new Error('Brak aktywnej sesji.');

        const update = {
            ...changes,
            updated_at: new Date().toISOString()
        };

        if (changes.group) {
            const current = allSubscribers.find(sub => sub.id === id);
            update.groups = Array.from(new Set([...(current?.groups || []), 'ai-radar', changes.group]));
        }

        await db.collection('newsletter_subscribers').doc(id).update(update);
        showToast('Zapisano kontakt newslettera', 'success');
    } catch (error) {
        console.error('Newsletter update error:', error);
        showToast(error.message || 'Błąd zapisu newslettera', 'error');
    }
}

function copyNewsletterEmails() {
    const emails = getFilteredSubscribers()
        .filter(s => (s.status || 'active') === 'active')
        .map(s => s.email)
        .filter(Boolean);

    if (emails.length === 0) {
        showToast('Brak aktywnych maili w tej grupie', 'info');
        return;
    }

    const text = emails.join(', ');
    navigator.clipboard.writeText(text).then(() => {
        showToast('Skopiowano ' + emails.length + ' maili', 'success');
    }).catch(() => {
        const ta = document.createElement('textarea');
        ta.value = text;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
        showToast('Skopiowano ' + emails.length + ' maili', 'success');
    });
}

function exportNewsletterCsv() {
    const subscribers = getFilteredSubscribers().filter(s => (s.status || 'active') === 'active');

    if (subscribers.length === 0) {
        showToast('Brak aktywnych kontaktów do eksportu', 'info');
        return;
    }

    const rows = [
        ['email', 'name', 'group', 'status', 'source', 'created_at', 'consent_at'],
        ...subscribers.map(s => [
            s.email || '',
            s.name || '',
            getNewsletterGroupLabel(s.group),
            s.status || 'active',
            s.source || '',
            s.created_at || '',
            s.consent?.accepted_at || ''
        ])
    ];

    const csv = rows.map(row => row.map(csvCell).join(',')).join('\n');
    const blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    const group = currentNewsletterGroup === 'all' ? 'wszystkie' : currentNewsletterGroup;
    link.href = url;
    link.download = `ai-radar-${group}-${new Date().toISOString().slice(0, 10)}.csv`;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);
    showToast('Wyeksportowano CSV', 'success');
}

function csvCell(value) {
    return '"' + String(value || '').replace(/"/g, '""') + '"';
}

// ===== HELPERS =====

function dateValue(ts) {
    if (!ts) return 0;
    if (ts.toDate) return ts.toDate().getTime();
    if (ts.seconds) return ts.seconds * 1000;
    const value = new Date(ts).getTime();
    return isNaN(value) ? 0 : value;
}

function formatDate(ts) {
    if (!ts) return '—';
    let d;
    if (ts.toDate) d = ts.toDate();
    else if (ts.seconds) d = new Date(ts.seconds * 1000);
    else d = new Date(ts);
    if (isNaN(d)) return '—';
    return d.toLocaleDateString('pl-PL', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
}

function escHtml(str) {
    if (!str) return '';
    const div = document.createElement('div');
    div.textContent = String(str);
    return div.innerHTML;
}

function escAttr(str) {
    return escHtml(str).replace(/"/g, '&quot;');
}

function escJs(str) {
    return String(str || '')
        .replace(/\\/g, '\\\\')
        .replace(/'/g, "\\'")
        .replace(/\r?\n/g, ' ');
}

function copyText(text, successMessage = 'Skopiowano') {
    if (!text) {
        showToast('Brak tekstu do skopiowania', 'info');
        return;
    }
    navigator.clipboard.writeText(text).then(() => {
        showToast(successMessage, 'success');
    }).catch(() => {
        const ta = document.createElement('textarea');
        ta.value = text;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
        showToast(successMessage, 'success');
    });
}

// ===== TOAST =====
function showToast(msg, type = 'info') {
    const container = document.getElementById('toastContainer');
    const colors = {
        success: 'border-green-500/30 bg-green-500/10 text-green-400',
        error: 'border-red-500/30 bg-red-500/10 text-red-400',
        info: 'border-blue-500/30 bg-blue-500/10 text-blue-400'
    };
    const icons = { success: 'check-circle-2', error: 'alert-circle', info: 'info' };

    const toast = document.createElement('div');
    toast.className = `toast-enter flex items-center gap-2 px-4 py-3 rounded-xl border backdrop-blur-md text-sm ${colors[type] || colors.info}`;
    toast.innerHTML = `<i data-lucide="${icons[type] || icons.info}" class="w-4 h-4"></i><span>${escHtml(msg)}</span>`;
    container.appendChild(toast);
    lucide.createIcons({ nodes: [toast] });

    setTimeout(() => {
        toast.classList.remove('toast-enter');
        toast.classList.add('toast-exit');
        setTimeout(() => toast.remove(), 300);
    }, 3000);
}

// ===== INIT LUCIDE =====
document.addEventListener('DOMContentLoaded', () => {
    lucide.createIcons();
});
