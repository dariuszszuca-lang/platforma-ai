rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasNewsletterShape() {
      return request.resource.data.keys().hasOnly([
        'id',
        'email',
        'name',
        'group',
        'groups',
        'status',
        'source',
        'page_url',
        'referrer',
        'utm',
        'consent',
        'created_at',
        'updated_at',
        'last_signup_at'
      ])
      && request.resource.data.email is string
      && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
      && request.resource.data.status == 'active'
      && request.resource.data.consent.newsletter == true;
    }

    // Wypis z newslettera (ai-radar-wypis.html). Jedyne, na co pozwala:
    // zmiana status na 'unsubscribed' i dopisanie unsubscribed_at, na istniejacym
    // dokumencie. Zaden inny klucz nie moze sie zmienic ani zniknac, wiec tedy nie da sie
    // podmienic maila, zgody, grupy ani niczego innego.
    function isUnsubscribeOnly() {
      return resource != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'unsubscribed_at'])
        && request.resource.data.status == 'unsubscribed'
        && request.resource.data.unsubscribed_at is string;
    }

    function hasGlobalworthResponseShape(responseId) {
      return request.resource.data.keys().hasOnly([
        'schema_version',
        'project_id',
        'response_id',
        'source',
        'status',
        'respondent',
        'data_notice_accepted',
        'answers',
        'summary',
        'created_at',
        'updated_at',
        'submitted_at'
      ])
      && request.resource.data.schema_version == 1
      && request.resource.data.project_id == 'globalworth-property-ai'
      && responseId.matches('^[A-Za-z0-9_-]{8,80}$')
      && request.resource.data.response_id == responseId
      && request.resource.data.source == 'globalworth-it-questionnaire'
      && request.resource.data.status == 'submitted'
      && request.resource.data.data_notice_accepted == true
      && request.resource.data.respondent is map
      && request.resource.data.respondent.keys().hasOnly(['name', 'email', 'role'])
      && request.resource.data.respondent.name is string
      && request.resource.data.respondent.email is string
      && request.resource.data.answers is map
      && request.resource.data.answers.keys().hasOnly([
        'it-tools-01',
        'it-tools-02',
        'it-tools-03',
        'it-systems-04',
        'it-systems-05',
        'it-systems-06',
        'it-systems-07',
        'it-data-08',
        'it-data-09',
        'it-data-10',
        'it-security-11',
        'it-security-12',
        'it-security-13',
        'it-security-14',
        'it-security-15',
        'it-owner-16'
      ])
      && request.resource.data.answers.keys().size() == 16
      && request.resource.data.summary is map
      && request.resource.data.summary.keys().hasOnly([
        'total',
        'complete',
        'answered',
        'needsClarification',
        'notApplicable',
        'openItems'
      ])
      && request.resource.data.summary.total == 16
      && request.resource.data.summary.complete == 16
      && request.resource.data.created_at is string
      && request.resource.data.updated_at is string
      && request.resource.data.submitted_at is string;
    }

    match /newsletter_subscribers/{subscriberId} {
      allow create: if hasNewsletterShape();
      allow update: if isSignedIn() || isUnsubscribeOnly() || (
        hasNewsletterShape()
        && resource.data.email == request.resource.data.email
        && resource.data.id == request.resource.data.id
      );
      allow read, delete: if isSignedIn();
    }

    match /newsletter_issues/{issueId} {
      allow read, write: if isSignedIn();
    }

    match /newsletter_sends/{sendId} {
      allow read, write: if isSignedIn();
    }

    // Finalne formularze Globalworth zapisuje wylacznie backend po zalogowaniu
    // technicznym kontem Firebase. Panel moze je czytac, ale nikt nie moze ich
    // edytowac ani kasowac po wyslaniu.
    match /globalworth_it_responses/{responseId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && hasGlobalworthResponseShape(responseId);
      allow update, delete: if false;
    }

    match /zlecenia/{orderId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn();
    }

    match /tracker_users/{userId} {
      allow read, create, update, delete: if isSignedIn() && request.auth.uid == userId;

      match /tasks/{taskId} {
        allow read, create, update, delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
