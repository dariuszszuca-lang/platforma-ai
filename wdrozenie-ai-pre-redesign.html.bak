    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Wdrożenie AI w małej firmie",
      "provider": {
        "@type": "ProfessionalService",
        "name": "AI-Team",
        "url": "https://ai-team.pl"
      },
      "areaServed": ["Gdańsk", "Trójmiasto", "Polska"],
      "description": "Diagnoza procesów, warsztaty AI, spersonalizowany CRM i automatyzacje dla małych firm.",
      "offers": [
        {
          "@type": "Offer",
          "name": "Spersonalizowany CRM",
          "price": "2500",
          "priceCurrency": "PLN"
        },
        {
          "@type": "Offer",
          "name": "Warsztat AI",
          "price": "600",
          "priceCurrency": "PLN"
        }
      ]
    }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        display: ['Space Grotesk', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            dark: '#020203',
                            primary: '#f97316',
                            secondary: '#ea580c',
                            light: '#22c55e',
                            info: '#38bdf8'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        * { box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body {
            min-height: 100vh;
            background: #020203;
            color: #e5e7eb;
            overflow-x: hidden;
        }
        .glass {
            background: rgba(255,255,255,0.055);
            border: 1px solid rgba(255,255,255,0.1);
            backdrop-filter: blur(18px);
        }
        .card {
            background: linear-gradient(145deg, rgba(255,255,255,0.075), rgba(255,255,255,0.025));
            border: 1px solid rgba(255,255,255,0.12);
            backdrop-filter: blur(20px);
        }
        .gradient-text {
            background: linear-gradient(90deg, #f97316, #fb923c, #22c55e);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .hero-bg {
            background-image:
                linear-gradient(90deg, rgba(2,2,3,0.96), rgba(2,2,3,0.82) 48%, rgba(2,2,3,0.7)),
                url('assets/ai-team-crm-demo.svg');
            background-size: cover;
            background-position: center;
        }
        .hero-copy {
            width: 100%;
            max-width: min(48rem, calc(100vw - 72px));
        }
        .bg-grid {
            background-image:
                linear-gradient(to right, rgba(255,255,255,0.045) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255,255,255,0.045) 1px, transparent 1px);
            background-size: 44px 44px;
            mask-image: linear-gradient(to bottom, rgba(0,0,0,1), rgba(0,0,0,0.15), transparent);
            -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1), rgba(0,0,0,0.15), transparent);
        }
        .focus-ring:focus-visible {
            outline: 3px solid rgba(249,115,22,0.75);
            outline-offset: 3px;
        }
        .loader {
            width: 18px;
            height: 18px;
            border: 2px solid transparent;
            border-top-color: #020203;
            border-radius: 9999px;
            animation: spin 0.7s linear infinite;
            display: inline-block;
        }
        @keyframes spin { to { transform: rotate(360deg); } }
        @media (prefers-reduced-motion: reduce) {
            html { scroll-behavior: auto; }
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                scroll-behavior: auto !important;
            }
        }
        @media (max-width: 767px) {
            .hero-copy {
                width: 100% !important;
                max-width: 260px !important;
                justify-self: start !important;
                margin-left: 0 !important;
                margin-right: auto !important;
            }
        }
    </style>
</head>
<body class="font-sans antialiased selection:bg-brand-primary selection:text-black">
    <div class="fixed inset-0 z-0 pointer-events-none bg-grid"></div>

    <nav class="fixed top-5 left-1/2 -translate-x-1/2 z-50 w-[94%] max-w-5xl">
        <div class="glass rounded-full px-4 py-3 flex items-center justify-between gap-4 bg-black/55">
            <a href="/" class="flex items-center gap-3 min-h-11 rounded-full px-2 focus-ring">
                <span class="relative flex h-3 w-3">
                    <span class="absolute inline-flex h-full w-full rounded-full bg-brand-primary opacity-70"></span>
                    <span class="relative inline-flex rounded-full h-3 w-3 bg-brand-primary"></span>
                </span>
                <span class="text-lg font-display font-bold tracking-tight text-white">AI-Team</span>
            </a>
            <div class="hidden md:flex items-center gap-1 bg-white/5 rounded-full p-1">
                <a href="#proces" class="px-4 py-2 text-sm text-gray-400 hover:text-white hover:bg-white/10 rounded-full transition focus-ring">Proces</a>
                <a href="#oferta" class="px-4 py-2 text-sm text-gray-400 hover:text-white hover:bg-white/10 rounded-full transition focus-ring">Oferta</a>
                <a href="#dowody" class="px-4 py-2 text-sm text-gray-400 hover:text-white hover:bg-white/10 rounded-full transition focus-ring">Dowody</a>
                <a href="/playbooki.html" class="px-4 py-2 text-sm text-gray-400 hover:text-white hover:bg-white/10 rounded-full transition focus-ring">Playbooki</a>
            </div>
            <a href="#kontakt" class="min-h-11 inline-flex items-center gap-2 rounded-full bg-brand-primary px-3 sm:px-5 py-2.5 text-sm font-bold text-black transition hover:scale-[1.02] focus-ring" aria-label="Umów diagnozę AI">
                <i data-lucide="send" class="h-4 w-4"></i>
                <span class="hidden sm:inline">Diagnoza</span>
            </a>
        </div>
    </nav>

    <main class="relative z-10">
        <section class="hero-bg min-h-[92dvh] flex items-center pt-32 pb-20">
            <div class="max-w-6xl mx-auto px-6">
                <div class="hero-copy max-w-3xl">
                    <div class="inline-flex items-center gap-2 rounded-full border border-brand-primary/30 bg-brand-primary/10 px-4 py-2 text-xs font-mono tracking-wider text-brand-primary mb-7">
                        <span class="h-2 w-2 rounded-full bg-brand-primary"></span>
                        WDROŻENIA AI DLA MAŁYCH FIRM
                    </div>
                    <h1 class="font-display text-3xl sm:text-4xl md:text-6xl lg:text-7xl font-bold leading-tight tracking-tight text-white mb-6">
                        Zamień ręczne procesy w <span class="gradient-text">system AI</span>, który działa codziennie.
                    </h1>
                    <p class="text-base sm:text-lg md:text-xl text-gray-300 leading-relaxed max-w-2xl mb-8">
                        Nie sprzedaję slajdów o przyszłości. Pomagam znaleźć proces, policzyć sens wdrożenia i zbudować prosty system: CRM, follow-upy, dokumenty, raporty albo warsztat dla zespołu.
                    </p>
                    <div class="flex flex-col sm:flex-row gap-4 mb-10">
                        <a href="#kontakt" class="min-h-12 inline-flex items-center justify-center gap-2 rounded-xl bg-brand-primary px-7 py-3 font-bold text-black transition hover:shadow-[0_0_28px_rgba(249,115,22,0.45)] focus-ring">
                            Umów diagnozę AI
                            <i data-lucide="arrow-right" class="h-5 w-5"></i>
                        </a>
                        <a href="/playbooki.html" class="min-h-12 inline-flex items-center justify-center gap-2 rounded-xl border border-white/15 bg-white/5 px-7 py-3 font-bold text-white transition hover:bg-white/10 focus-ring">
                            Pobierz playbook
                            <i data-lucide="download" class="h-5 w-5"></i>
                        </a>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 max-w-3xl">
                        <div class="glass rounded-xl p-4">
                            <div class="text-2xl font-display font-bold text-white">2 500 PLN</div>
                            <p class="text-xs text-gray-400 mb-0">CRM na własność</p>
                        </div>
                        <div class="glass rounded-xl p-4">
                            <div class="text-2xl font-display font-bold text-white">600 PLN</div>
                            <p class="text-xs text-gray-400 mb-0">warsztat AI / osoba</p>
                        </div>
                        <div class="glass rounded-xl p-4">
                            <div class="text-2xl font-display font-bold text-white">1-2 tyg.</div>
                            <p class="text-xs text-gray-400 mb-0">realizacja CRM</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section id="proces" class="py-24">
            <div class="max-w-6xl mx-auto px-6">
                <div class="max-w-3xl mb-12">
                    <p class="text-brand-primary font-bold uppercase tracking-[0.2em] text-xs mb-3">Podejście</p>
                    <h2 class="font-display text-3xl md:text-5xl font-bold text-white mb-4">Najpierw proces. Potem narzędzie.</h2>
                    <p class="text-gray-400 text-lg leading-relaxed">
                        Adaptuję model dużych wdrożeń AI do skali małej firmy: mniej konsultingu, więcej konkretu, krótkie cykle i człowiek w kontroli.
                    </p>
                </div>

                <div class="grid md:grid-cols-3 gap-5">
                    <article class="card rounded-2xl p-6">
                        <div class="h-12 w-12 rounded-xl bg-brand-primary/15 border border-brand-primary/30 flex items-center justify-center mb-5">
                            <i data-lucide="search-check" class="h-6 w-6 text-brand-primary"></i>
                        </div>
                        <h3 class="text-xl font-display font-bold text-white mb-3">Diagnoza</h3>
                        <p class="text-gray-400 text-sm leading-relaxed">Wypisujemy powtarzalne zadania, liczymy koszt czasu i wybieramy proces, który opłaca się naprawić jako pierwszy.</p>
                    </article>
                    <article class="card rounded-2xl p-6">
                        <div class="h-12 w-12 rounded-xl bg-brand-info/15 border border-brand-info/30 flex items-center justify-center mb-5">
                            <i data-lucide="workflow" class="h-6 w-6 text-brand-info"></i>
                        </div>
                        <h3 class="text-xl font-display font-bold text-white mb-3">Wdrożenie</h3>
                        <p class="text-gray-400 text-sm leading-relaxed">Buduję minimalny system: formularz, CRM, automatyzację, generator dokumentów albo przepływ mailowy.</p>
                    </article>
                    <article class="card rounded-2xl p-6">
                        <div class="h-12 w-12 rounded-xl bg-brand-light/15 border border-brand-light/30 flex items-center justify-center mb-5">
                            <i data-lucide="users" class="h-6 w-6 text-brand-light"></i>
                        </div>
                        <h3 class="text-xl font-display font-bold text-white mb-3">Szkolenie</h3>
                        <p class="text-gray-400 text-sm leading-relaxed">Pokazuję jak używać systemu, gdzie jest granica automatyzacji i co musi zatwierdzać człowiek.</p>
                    </article>
                </div>
            </div>
        </section>

        <section class="py-20 border-y border-white/10 bg-white/[0.025]">
            <div class="max-w-6xl mx-auto px-6 grid lg:grid-cols-[0.9fr_1.1fr] gap-8 items-start">
                <div>
                    <p class="text-brand-primary font-bold uppercase tracking-[0.2em] text-xs mb-3">Co zwykle automatyzujemy</p>
                    <h2 class="font-display text-3xl md:text-4xl font-bold text-white mb-4">Nie całą firmę naraz. Jeden workflow, który boli.</h2>
                    <p class="text-gray-400 leading-relaxed">Najlepsze pierwsze wdrożenie to takie, które oszczędza czas, nie wymaga rewolucji i ma prosty test skuteczności.</p>
                </div>
                <div class="grid sm:grid-cols-2 gap-4">
                    <div class="rounded-2xl border border-white/10 bg-black/35 p-5">
                        <i data-lucide="mail-check" class="h-6 w-6 text-brand-primary mb-3"></i>
                        <h3 class="font-bold text-white mb-2">Maile i follow-up</h3>
                        <p class="text-sm text-gray-400">Szkice odpowiedzi, przypomnienia, podsumowania rozmów i automatyczne zadania.</p>
                    </div>
                    <div class="rounded-2xl border border-white/10 bg-black/35 p-5">
                        <i data-lucide="database" class="h-6 w-6 text-brand-info mb-3"></i>
                        <h3 class="font-bold text-white mb-2">CRM i baza klientów</h3>
                        <p class="text-sm text-gray-400">Jedno miejsce na klientów, płatności, statusy, dokumenty i historię kontaktu.</p>
                    </div>
                    <div class="rounded-2xl border border-white/10 bg-black/35 p-5">
                        <i data-lucide="file-text" class="h-6 w-6 text-brand-light mb-3"></i>
                        <h3 class="font-bold text-white mb-2">Dokumenty</h3>
                        <p class="text-sm text-gray-400">Oferty, umowy, karty klienta, raporty i PDF-y generowane z danych.</p>
                    </div>
                    <div class="rounded-2xl border border-white/10 bg-black/35 p-5">
                        <i data-lucide="bar-chart-3" class="h-6 w-6 text-purple-300 mb-3"></i>
                        <h3 class="font-bold text-white mb-2">Raporty dla właściciela</h3>
                        <p class="text-sm text-gray-400">Co tydzień: leady, zadania, zaległości, sprzedaż i miejsca, gdzie proces się zatyka.</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="py-20">
            <div class="max-w-6xl mx-auto px-6">
                <div class="max-w-3xl mb-12">
                    <p class="text-brand-primary font-bold uppercase tracking-[0.2em] text-xs mb-3">Model sprzedaży</p>
                    <h2 class="font-display text-3xl md:text-5xl font-bold text-white mb-4">Model dużych wdrożeń, przeskalowany do małej firmy.</h2>
                    <p class="text-gray-400 text-lg leading-relaxed">Bierzemy mechanikę z rynku enterprise: edukacja, diagnoza, wdrożenie, opieka i rozliczanie za efekt pracy, nie za siedzenie na spotkaniach.</p>
                </div>

                <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
                    <div class="rounded-2xl border border-white/10 bg-black/35 p-5">
                        <div class="text-3xl font-display font-bold text-brand-primary mb-3">01</div>
                        <h3 class="font-bold text-white mb-2">Playbooki</h3>
                        <p class="text-sm text-gray-400">Publiczne instrukcje i worksheety zbierają leady lepiej niż ogólne „zapisz się do newslettera”.</p>
                    </div>
                    <div class="rounded-2xl border border-white/10 bg-black/35 p-5">
                        <div class="text-3xl font-display font-bold text-brand-info mb-3">02</div>
                        <h3 class="font-bold text-white mb-2">Audyt use case'ów</h3>
                        <p class="text-sm text-gray-400">Zamiast zaczynać od narzędzia, zaczynamy od procesu, kosztu czasu i wpływu na sprzedaż.</p>
                    </div>
                    <div class="rounded-2xl border border-white/10 bg-black/35 p-5">
                        <div class="text-3xl font-display font-bold text-brand-light mb-3">03</div>
                        <h3 class="font-bold text-white mb-2">Wdrożenie</h3>
                        <p class="text-sm text-gray-400">Pierwszy system ma być mały i działający: CRM, formularz, dokument, follow-up albo raport.</p>
                    </div>
                    <div class="rounded-2xl border border-white/10 bg-black/35 p-5">
                        <div class="text-3xl font-display font-bold text-purple-300 mb-3">04</div>
                        <h3 class="font-bold text-white mb-2">Stała opieka</h3>
                        <p class="text-sm text-gray-400">Po pierwszym wdrożeniu powstaje backlog usprawnień. To naturalna ścieżka do retaineru.</p>
                    </div>
                </div>
            </div>
        </section>

        <section id="oferta" class="py-24">
            <div class="max-w-6xl mx-auto px-6">
                <div class="text-center max-w-3xl mx-auto mb-12">
                    <p class="text-brand-primary font-bold uppercase tracking-[0.2em] text-xs mb-3">Oferta</p>
                    <h2 class="font-display text-3xl md:text-5xl font-bold text-white mb-4">Pełna drabina wdrożenia AI.</h2>
                    <p class="text-gray-400 text-lg leading-relaxed">Duże firmy kupują audyty, transformację, szkolenia i zespoły inżynierskie. U nas ten model jest przeskalowany do małej firmy: mniej enterprise, więcej konkretnego wdrożenia.</p>
                </div>

                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <article class="card rounded-2xl p-6 flex flex-col">
                        <p class="text-xs font-bold tracking-[0.18em] text-brand-info uppercase mb-3">Start</p>
                        <h3 class="text-2xl font-display font-bold text-white mb-2">Mapa AI</h3>
                        <p class="text-gray-400 text-sm leading-relaxed mb-5">Playbook i krótka diagnoza procesów. Dobre, jeśli jeszcze nie wiesz od czego zacząć.</p>
                        <div class="text-3xl font-display font-bold text-white mb-1">0 PLN</div>
                        <p class="text-xs text-gray-500 mb-6">materiał do pobrania</p>
                        <ul class="space-y-3 text-sm text-gray-300 mb-7 flex-1">
                            <li class="flex gap-2"><i data-lucide="check" class="h-5 w-5 text-brand-light shrink-0"></i> lista procesów do przejrzenia</li>
                            <li class="flex gap-2"><i data-lucide="check" class="h-5 w-5 text-brand-light shrink-0"></i> scoring opłacalności</li>
                            <li class="flex gap-2"><i data-lucide="check" class="h-5 w-5 text-brand-light shrink-0"></i> prompt do planu 30 dni</li>
                        </ul>
                        <a href="/playbooki.html" class="min-h-12 inline-flex items-center justify-center rounded-xl border border-white/15 bg-white/5 px-5 py-3 font-bold text-white hover:bg-white/10 focus-ring">Pobierz playbook</a>
                    </article>

                    <article class="card rounded-2xl p-6 flex flex-col">
                        <p class="text-xs font-bold tracking-[0.18em] text-brand-info uppercase mb-3">Strategia</p>
                        <h3 class="text-2xl font-display font-bold text-white mb-2">Audyt AI firmy</h3>
                        <p class="text-gray-400 text-sm leading-relaxed mb-5">Krótka diagnoza procesów, priorytetów i miejsc, gdzie AI może oszczędzić czas albo odzyskać leady.</p>
                        <div class="text-3xl font-display font-bold text-white mb-1">Wycena</div>
                        <p class="text-xs text-gray-500 mb-6">po diagnozie zakresu</p>
                        <ul class="space-y-3 text-sm text-gray-300 mb-7 flex-1">
                            <li class="flex gap-2"><i data-lucide="check" class="h-5 w-5 text-brand-light shrink-0"></i> ankieta procesów i rozmowa</li>
                            <li class="flex gap-2"><i data-lucide="check" class="h-5 w-5 text-brand-light shrink-0"></i> lista use case'ów z priorytetem</li>
                            <li class="flex gap-2"><i data-lucide="check" class="h-5 w-5 text-brand-light shrink-0"></i> roadmapa wdrożeń na 30 dni</li>
                        </ul>
                        <a href="#kontakt" class="min-h-12 inline-flex items-center justify-center rounded-xl border border-white/15 bg-white/5 px-5 py-3 font-bold text-white hover:bg-white/10 focus-ring">Zamów diagnozę</a>
                    </article>

                    <article class="card rounded-2xl p-6 flex flex-col border-brand-primary/40 bg-brand-primary/5 relative overflow-hidden">
                        <div class="absolute top-0 right-0 bg-brand-primary text-black text-[11px] font-bold px-3 py-1 rounded-bl-xl">NAJLEPSZY START</div>
                        <p class="text-xs font-bold tracking-[0.18em] text-brand-primary uppercase mb-3">Warsztat</p>
                        <h3 class="text-2xl font-display font-bold text-white mb-2">Warsztat AI</h3>
                        <p class="text-gray-400 text-sm leading-relaxed mb-5">Praktyczne spotkanie, po którym masz działającego asystenta AI i mapę automatyzacji dla firmy.</p>
                        <div class="text-3xl font-display font-bold text-white mb-1">600 PLN</div>
                        <p class="text-xs text-gray-500 mb-6">za osobę, dzień 1</p>
                        <ul class="space-y-3 text-sm text-gray-300 mb-7 flex-1">
                            <li class="flex gap-2"><i data-lucide="check" class="h-5 w-5 text-brand-light shrink-0"></i> 4 pliki kontekstowe firmy</li>
                            <li class="flex gap-2"><i data-lucide="check" class="h-5 w-5 text-brand-light shrink-0"></i> asystent AI dopasowany do firmy</li>
                            <li class="flex gap-2"><i data-lucide="check" class="h-5 w-5 text-brand-light shrink-0"></i> pakiet promptów i plan wdrożenia</li>
                        </ul>
                        <a href="#kontakt" class="min-h-12 inline-flex items-center justify-center rounded-xl bg-brand-primary px-5 py-3 font-bold text-black hover:shadow-[0_0_24px_rgba(249,115,22,0.45)] focus-ring">Zapytaj o termin</a>
                    </article>

                    <article class="card rounded-2xl p-6 flex flex-col">
                        <p class="text-xs font-bold tracking-[0.18em] text-purple-300 uppercase mb-3">Proces</p>
                        <h3 class="text-2xl font-display font-bold text-white mb-2">Sprint Automatyzacji AI</h3>
                        <p class="text-gray-400 text-sm leading-relaxed mb-5">Jedno wąskie wdrożenie: follow-up, raport, formularz, generator dokumentów albo przepływ leadów.</p>
                        <div class="text-3xl font-display font-bold text-white mb-1">Wycena</div>
                        <p class="text-xs text-gray-500 mb-6">po wyborze workflow</p>
                        <ul class="space-y-3 text-sm text-gray-300 mb-7 flex-1">
                            <li class="flex gap-2"><i data-lucide="check" class="h-5 w-5 text-brand-light shrink-0"></i> rozpisanie procesu na kroki</li>
                            <li class="flex gap-2"><i data-lucide="check" class="h-5 w-5 text-brand-light shrink-0"></i> automatyzacja z kontrolą człowieka</li>
                            <li class="flex gap-2"><i data-lucide="check" class="h-5 w-5 text-brand-light shrink-0"></i> test i poprawki po realnym użyciu</li>
                        </ul>
                        <a href="#kontakt" class="min-h-12 inline-flex items-center justify-center rounded-xl border border-white/15 bg-white/5 px-5 py-3 font-bold text-white hover:bg-white/10 focus-ring">Opisz workflow</a>
                    </article>

                    <article class="card rounded-2xl p-6 flex flex-col">
                        <p class="text-xs font-bold tracking-[0.18em] text-brand-light uppercase mb-3">System</p>
                        <h3 class="text-2xl font-display font-bold text-white mb-2">CRM na własność</h3>
                        <p class="text-gray-400 text-sm leading-relaxed mb-5">Dedykowany system CRM dla firmy, która ma dość Excela, karteczek i abonamentów za narzędzia.</p>
                        <div class="text-3xl font-display font-bold text-white mb-1">2 500 PLN</div>
                        <p class="text-xs text-gray-500 mb-6">lifetime, bez abonamentu</p>
                        <ul class="space-y-3 text-sm text-gray-300 mb-7 flex-1">
                            <li class="flex gap-2"><i data-lucide="check" class="h-5 w-5 text-brand-light shrink-0"></i> baza klientów i procesów</li>
                            <li class="flex gap-2"><i data-lucide="check" class="h-5 w-5 text-brand-light shrink-0"></i> panel administracyjny</li>
                            <li class="flex gap-2"><i data-lucide="check" class="h-5 w-5 text-brand-light shrink-0"></i> kod na Twoim GitHubie</li>
                        </ul>
                        <a href="#kontakt" class="min-h-12 inline-flex items-center justify-center rounded-xl border border-white/15 bg-white/5 px-5 py-3 font-bold text-white hover:bg-white/10 focus-ring">Opisz CRM</a>
                    </article>

                    <article class="card rounded-2xl p-6 flex flex-col">
                        <p class="text-xs font-bold tracking-[0.18em] text-brand-light uppercase mb-3">Opieka</p>
                        <h3 class="text-2xl font-display font-bold text-white mb-2">Zewnętrzny Dział AI</h3>
                        <p class="text-gray-400 text-sm leading-relaxed mb-5">Stały backlog usprawnień, techniczne wsparcie i regularne wdrażanie małych automatyzacji.</p>
                        <div class="text-3xl font-display font-bold text-white mb-1">Wycena</div>
                        <p class="text-xs text-gray-500 mb-6">po ustaleniu zakresu</p>
                        <ul class="space-y-3 text-sm text-gray-300 mb-7 flex-1">
                            <li class="flex gap-2"><i data-lucide="check" class="h-5 w-5 text-brand-light shrink-0"></i> lista zadań i priorytety</li>
                            <li class="flex gap-2"><i data-lucide="check" class="h-5 w-5 text-brand-light shrink-0"></i> cykliczne check-iny</li>
                            <li class="flex gap-2"><i data-lucide="check" class="h-5 w-5 text-brand-light shrink-0"></i> rozwój CRM, automatyzacji i promptów</li>
                        </ul>
                        <a href="#kontakt" class="min-h-12 inline-flex items-center justify-center rounded-xl border border-white/15 bg-white/5 px-5 py-3 font-bold text-white hover:bg-white/10 focus-ring">Ustal zakres</a>
                    </article>
                </div>
            </div>
        </section>

        <section id="dowody" class="py-20 border-y border-white/10 bg-white/[0.025]">
            <div class="max-w-6xl mx-auto px-6 grid lg:grid-cols-[1fr_1fr] gap-8 items-center">
                <div>
                    <p class="text-brand-primary font-bold uppercase tracking-[0.2em] text-xs mb-3">Dowód</p>
                    <h2 class="font-display text-3xl md:text-4xl font-bold text-white mb-4">To podejście już działa w projektach usługowych.</h2>
                    <p class="text-gray-400 leading-relaxed mb-5">
                        Najmocniejszy przykład to CRM dla MyWay: rejestracja pacjentów, dane osobowe, płatności, pakiety, generowanie dokumentów i logika dopasowana do realnej pracy zespołu.
                    </p>
                    <p class="text-gray-400 leading-relaxed">
                        Właśnie tak wygląda dobra automatyzacja dla małej firmy: nie wielki system „na wszystko”, tylko narzędzie dokładnie pod proces.
                    </p>
                </div>
                <div class="card rounded-2xl p-4">
                    <img src="assets/ai-team-crm-demo.svg" alt="Anonimowy mockup CRM dla małej firmy" class="w-full rounded-xl border border-white/10">
                </div>
            </div>
        </section>

        <section class="py-24">
            <div class="max-w-5xl mx-auto px-6">
                <div class="text-center mb-12">
                    <p class="text-brand-primary font-bold uppercase tracking-[0.2em] text-xs mb-3">Obiekcje</p>
                    <h2 class="font-display text-3xl md:text-5xl font-bold text-white">Najczęstsze pytania przed wdrożeniem.</h2>
                </div>
                <div class="grid md:grid-cols-2 gap-4">
                    <div class="card rounded-2xl p-6">
                        <h3 class="font-bold text-white mb-2">Czy muszę znać technologię?</h3>
                        <p class="text-sm text-gray-400 leading-relaxed">Nie. Twoim zadaniem jest pokazać proces. Moim zadaniem jest dobrać narzędzie i zbudować prosty system.</p>
                    </div>
                    <div class="card rounded-2xl p-6">
                        <h3 class="font-bold text-white mb-2">Czy AI będzie samo wysyłać wiadomości?</h3>
                        <p class="text-sm text-gray-400 leading-relaxed">Na start nie. Najbezpieczniejszy model to szkice, podsumowania i zadania do akceptacji przez człowieka.</p>
                    </div>
                    <div class="card rounded-2xl p-6">
                        <h3 class="font-bold text-white mb-2">Co jeśli mam już CRM?</h3>
                        <p class="text-sm text-gray-400 leading-relaxed">Sprawdzamy, czy da się go wykorzystać. Dedykowany CRM ma sens wtedy, gdy gotowe narzędzie wymusza zły proces albo kosztuje za dużo.</p>
                    </div>
                    <div class="card rounded-2xl p-6">
                        <h3 class="font-bold text-white mb-2">Od czego zaczynamy?</h3>
                        <p class="text-sm text-gray-400 leading-relaxed">Od krótkiej diagnozy. Jedno spotkanie, jeden proces, jedna decyzja: warsztat, CRM, automatyzacja albo nic, jeśli nie ma sensu.</p>
                    </div>
                </div>
            </div>
        </section>

        <section id="kontakt" class="py-24 bg-black">
            <div class="max-w-5xl mx-auto px-6 grid lg:grid-cols-[0.95fr_1.05fr] gap-8 items-stretch">
                <div class="card rounded-2xl p-7 md:p-8">
                    <p class="text-brand-primary font-bold uppercase tracking-[0.2em] text-xs mb-3">CTA</p>
                    <h2 class="font-display text-3xl md:text-4xl font-bold text-white mb-4">Opisz proces, który chcesz przestać robić ręcznie.</h2>
                    <p class="text-gray-300 leading-relaxed mb-6">
                        Nie musisz wiedzieć, czy to ma być CRM, agent, prompt czy automatyzacja. Wystarczy, że opiszesz gdzie tracisz czas.
                    </p>
                    <div class="space-y-3 text-sm text-gray-300">
                        <div class="flex gap-3"><i data-lucide="check-circle" class="h-5 w-5 text-brand-light shrink-0"></i> odpowiem z konkretnym następnym krokiem</div>
                        <div class="flex gap-3"><i data-lucide="check-circle" class="h-5 w-5 text-brand-light shrink-0"></i> jeśli to CRM, dostaniesz zakres i harmonogram</div>
                        <div class="flex gap-3"><i data-lucide="check-circle" class="h-5 w-5 text-brand-light shrink-0"></i> jeśli to warsztat, ustalimy termin i grupę</div>
                    </div>
                </div>

                <div class="card rounded-2xl p-7 md:p-8">
                    <form id="ai-implementation-form" class="space-y-5">
                        <div>
                            <label for="lead-name" class="block text-sm font-semibold text-white mb-2">Imię</label>
                            <input id="lead-name" name="name" type="text" required autocomplete="given-name" class="focus-ring w-full rounded-xl border border-white/10 bg-black/45 px-4 py-3 text-white placeholder:text-gray-600" placeholder="Np. Michał">
                        </div>
                        <div>
                            <label for="lead-email" class="block text-sm font-semibold text-white mb-2">Email</label>
                            <input id="lead-email" name="email" type="email" required autocomplete="email" class="focus-ring w-full rounded-xl border border-white/10 bg-black/45 px-4 py-3 text-white placeholder:text-gray-600" placeholder="twoj@email.pl">
                        </div>
                        <div>
                            <label for="lead-company" class="block text-sm font-semibold text-white mb-2">Firma / branża</label>
                            <input id="lead-company" name="company" type="text" class="focus-ring w-full rounded-xl border border-white/10 bg-black/45 px-4 py-3 text-white placeholder:text-gray-600" placeholder="Np. gabinet, kancelaria, nieruchomości">
                        </div>
                        <div>
                            <label for="lead-offer" class="block text-sm font-semibold text-white mb-2">Co Cię interesuje?</label>
                            <select id="lead-offer" name="offer" class="focus-ring w-full rounded-xl border border-white/10 bg-black/45 px-4 py-3 text-white">
                                <option value="diagnoza-ai">Diagnoza AI / nie wiem od czego zacząć</option>
                                <option value="warsztat-ai">Warsztat AI</option>
                                <option value="crm">CRM na własność</option>
                                <option value="automatyzacja">Automatyzacja konkretnego procesu</option>
                            </select>
                        </div>
                        <div>
                            <label for="lead-message" class="block text-sm font-semibold text-white mb-2">Jaki proces boli najbardziej?</label>
                            <textarea id="lead-message" name="message" rows="4" required class="focus-ring w-full rounded-xl border border-white/10 bg-black/45 px-4 py-3 text-white placeholder:text-gray-600 resize-none" placeholder="Np. leady wpadają z formularza, potem ręcznie przepisuję je do Excela i zapominam o follow-upie..."></textarea>
                        </div>
                        <button type="submit" id="ai-implementation-submit" class="focus-ring min-h-12 w-full inline-flex items-center justify-center gap-2 rounded-xl bg-brand-primary px-6 py-3 font-bold text-black transition hover:shadow-[0_0_28px_rgba(249,115,22,0.45)]">
                            <i data-lucide="send" class="h-5 w-5"></i>
                            Wyślij do diagnozy
                        </button>
                        <p class="text-xs text-gray-500 text-center">Odpiszę osobiście. Bez spamu i bez automatycznej sprzedaży.</p>
                    </form>
                    <div id="ai-implementation-success" class="hidden text-center py-8">
                        <div class="mx-auto mb-4 h-14 w-14 rounded-full bg-brand-light/15 border border-brand-light/30 flex items-center justify-center">
                            <i data-lucide="check" class="h-7 w-7 text-brand-light"></i>
                        </div>
                        <h3 class="text-2xl font-display font-bold text-white mb-2">Wysłane.</h3>
                        <p class="text-gray-400 mb-5">Darek dostanie opis procesu i może wrócić z konkretną propozycją.</p>
                        <a href="https://wa.me/48730600383" target="_blank" rel="noopener" class="focus-ring inline-flex items-center gap-2 rounded-xl bg-white px-5 py-3 font-bold text-black">
                            Dopisz na WhatsApp <i data-lucide="message-circle" class="h-4 w-4"></i>
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <footer class="relative z-10 border-t border-white/10 py-8 text-center text-sm text-gray-500">
        <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row justify-between gap-3">
            <p>AI-Team</p>
            <div class="flex justify-center gap-5">
                <a href="/privacy.html" class="hover:text-white focus-ring rounded">Prywatność</a>
                <a href="/playbooki.html" class="hover:text-white focus-ring rounded">Playbooki</a>
                <a href="/ai-radar.html" class="hover:text-white focus-ring rounded">AI Radar</a>
            </div>
        </div>
    </footer>

    <script>
        lucide.createIcons();

        document.getElementById('ai-implementation-form').addEventListener('submit', async function(e) {
            e.preventDefault();

            const form = e.target;
            const btn = document.getElementById('ai-implementation-submit');
            const originalText = btn.innerHTML;
            const name = document.getElementById('lead-name').value;
            const email = document.getElementById('lead-email').value;

            btn.innerHTML = '<span class="loader"></span> Wysyłam...';
            btn.disabled = true;

            try {
                const mlData = new FormData();
                mlData.append('fields[name]', name);
                mlData.append('fields[email]', email);
                mlData.append('ml-submit', '1');
                mlData.append('anticsrf', 'true');

                await fetch('https://assets.mailerlite.com/jsonp/2005256/forms/175136599785342826/subscribe', {
                    method: 'POST',
                    body: mlData,
                    mode: 'no-cors'
                });

                const notifyData = new FormData(form);
                notifyData.append('_subject', '[AI-Team] Nowy lead - Wdrożenie AI');
                notifyData.append('_template', 'table');
                fetch('https://formsubmit.co/ajax/dariusz.szuca@gmail.com', {
                    method: 'POST',
                    body: notifyData
                });

                if (typeof gtag === 'function') {
                    gtag('event', 'generate_lead', {
                        event_category: 'Sales Lead',
                        event_label: 'Wdrozenie AI',
                        value: 1
                    });
                }

                form.classList.add('hidden');
                document.getElementById('ai-implementation-success').classList.remove('hidden');
                lucide.createIcons();
            } catch (error) {
                btn.innerHTML = originalText;
                btn.disabled = false;
                lucide.createIcons();
            }
        });
    </script>
</body>
</html>
