    <title>Wdrożenie AI w małej firmie | AI-Team Gdańsk</title>
    <meta name="description" content="Wdrożenia AI dla małych firm: diagnoza procesów, CRM na własność, automatyzacje, warsztaty i opieka techniczna. Bez slajdów dla slajdów.">
    <meta name="keywords" content="wdrożenie AI w firmie, automatyzacja małej firmy, CRM dla małej firmy, warsztat AI, AI-Team Gdańsk">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="https://ai-team.pl/wdrozenie-ai.html">

    <meta property="og:type" content="website">
